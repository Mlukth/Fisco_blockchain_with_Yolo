# FISCO BCOS 配置
FISCO_RPC_URL=http://127.0.0.1:8545
FISCO_GROUP_ID=1
FISCO_CHAIN_ID=1
ADMIN_PRIVATE_KEY=0x...（填写部署合约的管理员私钥）
CONTRACT_ADDRESS=（部署后自动填写或手动填写）

# 服务器配置
PORT=3002
JWT_SECRET=your-secret-key-change-in-production
ATTENDANCE_STORAGE_PATH=./server/attendance_storage
ATTENDANCE_BASE_URL=/attendance

# 允许完全重置（生产环境务必设为 false）
ALLOW_FULL_RESET=true