# FISCO BCOS 3.x 配置
# Channel 连接（WebSocket 协议）
FISCO_CHANNEL_URL=127.0.0.1:20200
FISCO_GROUP_ID=group0
FISCO_CHAIN_ID=chain0

# 管理员账户私钥（请填写部署合约的账户私钥）
ADMIN_PRIVATE_KEY=0x...（请填写部署合约的账户私钥）

# 合约地址（部署后自动填写，或手动填写）
CONTRACT_ADDRESS=

# SDK 证书路径（FISCO BCOS 3.x 必需）
SDK_CERT_PATH=./nodes/127.0.0.1/sdk
SDK_CA_CERT=sdk.crt
SDK_SSL_CERT=sdk.crt
SDK_SSL_KEY=sdk.key

# 服务器配置
PORT=3002
JWT_SECRET=your-secret-key-change-in-production
ATTENDANCE_STORAGE_PATH=./server/attendance_storage
ATTENDANCE_BASE_URL=/api/attendance-files

# 安全选项
ALLOW_FULL_RESET=true