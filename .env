# FISCO BCOS 配置
FISCO_RPC_URL=http://127.0.0.1:8545
FISCO_GROUP_ID=1
FISCO_CHAIN_ID=1
ADMIN_PRIVATE_KEY=0x...（请填写部署合约的账户私钥）
CONTRACT_ADDRESS=（部署后自动填写，或手动填写）

# 服务器配置
PORT=3002
JWT_SECRET=your-secret-key-change-in-production
ATTENDANCE_STORAGE_PATH=./server/attendance_storage
ATTENDANCE_BASE_URL=/api/attendance-files

# 安全选项
ALLOW_FULL_RESET=true
