# 区块链连接配置
FISCO_CHANNEL_URL=127.0.0.1:20200
FISCO_GROUP_ID=group0
FISCO_CHAIN_ID=chain0

# 合约地址（部署后自动填充）
CONTRACT_ADDRESS=

# 管理员私钥（用于发送上链交易，请填写实际私钥）
ADMIN_PRIVATE_KEY=

# JWT 密钥
JWT_SECRET=your-secret-key-change-in-production

# 后端服务端口
PORT=3002

# 考勤数据存储路径（可选）
ATTENDANCE_STORAGE_PATH=./attendance_storage